#
# PMMP Dockerfile
#
# docker build -t nethergamesmc/servers:skyblock --build-arg BUILD_FROM=nethergamesmc/servers:base -f SkyBlock/Dockerfile .
#
# Expects the build context to contain, in addition to this repo:
#   xSkyBlock.phar           - built by this repo's build workflow
#
# Unlike the arena minigames, SkyBlock has no arena assets: player islands are
# persistent worlds streamed from S3-compatible object storage at runtime, and the
# Hub world is generated by PocketMine on first boot if absent.
#
# Island storage is configured through the environment when developmentMode is off
# (see SkyBlock.php); mount them at runtime, e.g.:
#   docker run -e S3_BUCKET=... -e S3_ACCESS_KEY=... -e S3_SECRET_KEY=... \
#              -e S3_REGION=... -e S3_ENDPOINT=... ...
#
ARG BUILD_FROM=nethergamesmc/servers:base
FROM $BUILD_FROM

ARG SERVER_TYPE=SB
COPY docker/ngessentials-config.yml /home/plugin_data/NGEssentials/config.yml
RUN sed -i "s/__SERVER_TYPE__/${SERVER_TYPE}/" /home/plugin_data/NGEssentials/config.yml
ADD xSkyBlock.phar /home/plugins/xSkyBlock.phar

# Worlds and island templates are published in the assets repository. Uncomment to bake them in, or
# prefer docker/server.Dockerfile, which mounts an assets checkout at runtime instead.
# ADD assets/SkyBlock/worlds /home/worlds
# ADD assets/SkyBlock/DefaultIslands /home/plugin_data/NGSkyBlock/DefaultIslands
